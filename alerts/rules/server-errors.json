{
  "apiVersion": "rules.alerting.grafana.app/v0alpha1",
  "kind": "AlertRule",
  "metadata": {
    "name": "document-lab-server-errors",
    "annotations": {
      "grafana.app/folder": "grafana-observability-lab"
    }
  },
  "spec": {
    "title": "Document Lab · Aanhoudende serverfouten",
    "trigger": {
      "interval": "1m"
    },
    "for": "2m",
    "noDataState": "Ok",
    "execErrState": "Error",
    "paused": false,
    "labels": {
      "project": "document-lab",
      "environment": "lab",
      "severity": "warning"
    },
    "annotations": {
      "summary": "Document Lab · Aanhoudende serverfouten",
      "description": "Minstens 3 HTTP 5xx-antwoorden in 5 minuten, gedurende 2 minuten. Zoek ERROR-logs en bijbehorende traces. HTTP 4xx telt niet mee.",
      "runbook_url": "https://github.com/phlppgdfry/grafana-observability-lab/blob/main/alerts/README.md"
    },
    "expressions": {
      "A": {
        "datasourceUID": "grafanacloud-logs",
        "relativeTimeRange": {
          "from": "10m",
          "to": "0s"
        },
        "model": {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"document-lab\",deployment_environment_name=\"lab\"} | http_response_status_code >= 500 [5m])) or vector(0)",
          "instant": true,
          "range": false,
          "queryType": "instant",
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      "B": {
        "datasourceUID": "__expr__",
        "source": true,
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "type": "query",
              "query": {
                "params": [
                  "A"
                ]
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "evaluator": {
                "type": "gt",
                "params": [
                  2
                ]
              },
              "operator": {
                "type": "and"
              }
            }
          ]
        }
      }
    },
    "notificationSettings": {
      "type": "SimplifiedRouting",
      "receiver": "document-lab-email",
      "groupBy": [
        "alertname",
        "grafana_folder"
      ],
      "groupWait": "30s",
      "groupInterval": "5m",
      "repeatInterval": "24h"
    }
  }
}
